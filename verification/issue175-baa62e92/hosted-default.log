2026-10-23T16:52:37.1278139Z         }
2026-10-23T16:52:37.1278361Z         else {
2026-10-23T16:52:37.1280957Z             Write-AlpacaDebug ("customCodeCops for test apps is the same as the default setting: {0}" -f (ConvertTo-AlpacaOutputString -ReplaceNullAndEmptyString -Value $customCodeCopsForTestApps))
2026-10-23T16:52:37.1283563Z         }
2026-10-23T16:52:37.1283801Z 
2026-10-23T16:52:37.1284513Z         Write-AlpacaDebug "Looking for rulesetFile..."
2026-10-23T16:52:37.1285523Z         $currentRuleSetFile = $null
2026-10-23T16:52:37.1286213Z         if ($CompilationParams.Value.Keys -contains 'ruleset') {
