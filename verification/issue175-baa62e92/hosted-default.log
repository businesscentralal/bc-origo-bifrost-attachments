2026-10-23T16:52:37.1305362Z         }
2026-10-23T16:52:37.1305686Z     }
2026-10-23T16:52:37.1306649Z     else {
2026-10-23T16:52:37.1308127Z         Write-AlpacaDebug "Not a test app or bcpt app, or enableCodeAnalyzersOnTestApps is not set. No custom settings applied."
