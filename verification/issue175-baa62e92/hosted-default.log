2026-10-23T16:52:37.1175181Z     if ($enableExternalRulesets -and $CompilationParams.Value.Keys -contains 'compilerFolder') {
2026-10-23T16:52:37.1178215Z         Write-AlpacaDebug "EnableExternalRulesets is set to true and compilerFolder is specified. Checking compiler version..."
2026-10-23T16:52:37.1181376Z         $compilerPackageJsonPath = Join-Path -Path $CompilationParams.Value['compilerFolder'] -ChildPath 'compiler' -AdditionalChildPath 'extension', 'package.json'
2026-10-23T16:52:37.1182978Z         if (Test-Path $compilerPackageJsonPath) {
