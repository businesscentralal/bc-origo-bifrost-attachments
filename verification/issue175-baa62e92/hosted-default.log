2026-10-23T16:52:37.1208219Z #region CustomSettingsForTestApps
2026-10-23T16:52:37.1209862Z Write-AlpacaGroupStart "Custom Settings For Test Apps" #Level 1
2026-10-23T16:52:37.1211209Z try {
2026-10-23T16:52:37.1213242Z     if ($AppType -in @('testApp', 'bcptApp') -and $settings.enableCodeAnalyzersOnTestApps) {
2026-10-23T16:52:37.1214858Z         $analyzerToggleMappings = @(
2026-10-23T16:52:37.1215986Z             @{ CompilationParamKey = 'enableCodeCop'; AlpacaSettingKey = 'enableCodeCopForTestApps' }
2026-10-23T16:52:37.1219464Z             @{ CompilationParamKey = 'enableUICop'; AlpacaSettingKey = 'enableUICopForTestApps' }
2026-10-23T16:52:37.1222156Z             @{ CompilationParamKey = 'enablePerTenantExtensionCop'; AlpacaSettingKey = 'enablePerTenantExtensionCopForTestApps' }
2026-10-23T16:52:37.1225061Z             @{ CompilationParamKey = 'enableAppSourceCop'; AlpacaSettingKey = 'enableAppSourceCopForTestApps' }
2026-10-23T16:52:37.1226696Z         )
2026-10-23T16:52:37.1227141Z 
2026-10-23T16:52:37.1227776Z         foreach ($mapping in $analyzerToggleMappings) {
2026-10-23T16:52:37.1229802Z             $compilationParamKey = $mapping.CompilationParamKey
2026-10-23T16:52:37.1230808Z             $alpacaSettingKey = $mapping.AlpacaSettingKey
2026-10-23T16:52:37.1231250Z 
2026-10-23T16:52:37.1231580Z             Write-AlpacaDebug "Looking for $compilationParamKey..."
2026-10-23T16:52:37.1232060Z 
2026-10-23T16:52:37.1232476Z             $currentValue = $null
2026-10-23T16:52:37.1233572Z             if ($CompilationParams.Value.Keys -contains $compilationParamKey) {
2026-10-23T16:52:37.1236484Z                 $currentValue = $CompilationParams.Value[$compilationParamKey]
2026-10-23T16:52:37.1237223Z             }
2026-10-23T16:52:37.1237449Z 
2026-10-23T16:52:37.1237717Z             $targetValue = $alpacaSettings.$alpacaSettingKey
2026-10-23T16:52:37.1238648Z             if ($targetValue -notin $currentValue, $null) {
2026-10-23T16:52:37.1239827Z                 Write-AlpacaOutput ("Overriding {0} for test apps: {1} -> {2}" -f $compilationParamKey, (ConvertTo-AlpacaOutputString -ReplaceNullAndEmptyString -Value $currentValue), (ConvertTo-AlpacaOutputString -ReplaceNullAndEmptyString -Value $targetValue))
2026-10-23T16:52:37.1241927Z                 $CompilationParams.Value[$compilationParamKey] = $targetValue
2026-10-23T16:52:37.1242597Z             }
2026-10-23T16:52:37.1242998Z             else {
2026-10-23T16:52:37.1243824Z                 Write-AlpacaDebug "$compilationParamKey for test apps is the same as the default setting: $targetValue"
2026-10-23T16:52:37.1244662Z             }
2026-10-23T16:52:37.1245250Z         }
2026-10-23T16:52:37.1245466Z 
2026-10-23T16:52:37.1245731Z         Write-AlpacaDebug "Looking for customCodeCops..."
2026-10-23T16:52:37.1246846Z         $currentCustomCodeCops = @()
2026-10-23T16:52:37.1249876Z         if ($CompilationParams.Value.Keys -contains 'customCodeCops') {
2026-10-23T16:52:37.1251463Z             Write-AlpacaDebug "CompilationParams contains customCodeCops."
2026-10-23T16:52:37.1252601Z             $currentCustomCodeCops = $CompilationParams.Value.customCodeCops
2026-10-23T16:52:37.1253894Z         }
2026-10-23T16:52:37.1254290Z         else {
2026-10-23T16:52:37.1254915Z             Write-AlpacaDebug "CompilationParams does not contain customCodeCops."
2026-10-23T16:52:37.1255684Z         }
2026-10-23T16:52:37.1256197Z         Write-AlpacaDebug "Comparing current customCodeCops."
2026-10-23T16:52:37.1257273Z         $customCodeCopsForTestApps = $alpacaSettings.customCodeCopsForTestApps
2026-10-23T16:52:37.1260239Z         $customCodeCopsForTestApps = @($customCodeCopsForTestApps | ForEach-Object { CheckRelativePath -baseFolder $baseFolder -sharedFolder $sharedFolder -path $_ -name "customCodeCopsForTestApps" } | Where-Object { $_ -and ($_ -like 'https://*' -or (Test-Path $_)) } )
2026-10-23T16:52:37.1262540Z 
2026-10-23T16:52:37.1263418Z         if (Compare-Object -ReferenceObject $customCodeCopsForTestApps -DifferenceObject $currentCustomCodeCops) {
2026-10-23T16:52:37.1266997Z             Write-AlpacaOutput ("Overriding customCodeCops for test apps: {0} -> {1}" -f (ConvertTo-AlpacaOutputString -ReplaceNullAndEmptyString -Value $currentCustomCodeCops), (ConvertTo-AlpacaOutputString -ReplaceNullAndEmptyString -Value $alpacaSettings.customCodeCopsForTestApps))
2026-10-23T16:52:37.1270118Z             if (@($customCodeCopsForTestApps).Count -eq 0) {
2026-10-23T16:52:37.1271063Z                 Write-AlpacaDebug "Removing customCodeCops from CompilationParams."
