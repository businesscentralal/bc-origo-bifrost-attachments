2026-10-23T16:52:37.1080938Z CompileAppWithBcCompilerFolder override
2026-10-23T16:52:37.1082114Z param([hashtable] $CompilationParams)
2026-10-23T16:52:37.1082742Z 
2026-10-23T16:52:37.1082979Z $ErrorActionPreference = 'Stop'
2026-10-23T16:52:37.1083298Z 
2026-10-23T16:52:37.1083553Z function Enable-LinuxCompilerManifestStamps {
2026-10-23T16:52:37.1085358Z     # BcContainerHelper 6.1.19 stamps /SourceCommit and /BuildUrl only when the compiler
2026-10-23T16:52:37.1086974Z     # file version is at least 12.0.12.41479. Linux ELF alc has no PE file version, so the
2026-10-23T16:52:37.1088867Z     # helper skips those arguments and the package commit does not match the run.
2026-10-23T16:52:37.1090063Z     if (-not ($IsLinux -or $IsMacOS)) {
2026-10-23T16:52:37.1091392Z         return
2026-10-23T16:52:37.1092416Z     }
2026-10-23T16:52:37.1093052Z     $command = Get-Command Compile-AppWithBcCompilerFolder -ErrorAction Stop
2026-10-23T16:52:37.1094723Z     $body = $command.Definition
2026-10-23T16:52:37.1095227Z     if ($body -match 'no PE file version') {
2026-10-23T16:52:37.1096038Z         return
2026-10-23T16:52:37.1096469Z     }
2026-10-23T16:52:37.1097229Z     $pattern = '(?m)^(?<indent>[ \t]*)\[System\.Version\]\$alcVersion = \$alcItem\.VersionInfo\.FileVersion\s*$'
2026-10-23T16:52:37.1098839Z     if ($body -notmatch $pattern) {
2026-10-23T16:52:37.1099760Z         if (-not $command.Module -and $body -notmatch 'alcItem') {
2026-10-23T16:52:37.1101135Z             return
2026-10-23T16:52:37.1102358Z         }
2026-10-23T16:52:37.1103216Z         throw 'BcContainerHelper compiler version assignment was not found; manifest stamps cannot be restored.'
2026-10-23T16:52:37.1104613Z     }
2026-10-23T16:52:37.1105159Z     $patched = [regex]::Replace($body, $pattern, {
2026-10-23T16:52:37.1106022Z             param($match)
2026-10-23T16:52:37.1106532Z             $indent = $match.Groups['indent'].Value
2026-10-23T16:52:37.1107086Z             @"
2026-10-23T16:52:37.1108278Z ${indent}[System.Version]`$alcVersion = `$null
2026-10-23T16:52:37.1109864Z ${indent}try { `$alcVersion = [System.Version]`$alcItem.VersionInfo.FileVersion } catch { `$alcVersion = `$null }
2026-10-23T16:52:37.1111930Z ${indent}if (-not `$alcVersion -or `$alcVersion -lt [System.Version]'1.0.0.0') {
2026-10-23T16:52:37.1113769Z ${indent}    # Linux ELF alc reports no PE file version, so the helper skips /SourceCommit and /BuildUrl.
2026-10-23T16:52:37.1115547Z ${indent}    `$alcVersion = [System.Version]'12.0.12.41479'
2026-10-23T16:52:37.1116165Z ${indent}}
2026-10-23T16:52:37.1116831Z "@
2026-10-23T16:52:37.1117607Z         })
2026-10-23T16:52:37.1117998Z     if ($command.Module) {
2026-10-23T16:52:37.1119004Z         # Export-ModuleMember snapshots the function. Replace the module copy and the exported command.
2026-10-23T16:52:37.1121008Z         $patchedBlock = $command.Module.NewBoundScriptBlock([scriptblock]::Create($patched))
2026-10-23T16:52:37.1122872Z         & $command.Module { param($block) ${function:script:Compile-AppWithBcCompilerFolder} = $block } $patchedBlock
2026-10-23T16:52:37.1125226Z         $field = $command.GetType().GetField('_scriptBlock', [System.Reflection.BindingFlags]'Instance,NonPublic')
2026-10-23T16:52:37.1126433Z         if (-not $field) {
2026-10-23T16:52:37.1127519Z             throw 'Cannot update the exported compiler function.'
2026-10-23T16:52:37.1128441Z         }
2026-10-23T16:52:37.1129190Z         $field.SetValue($command, $patchedBlock)
2026-10-23T16:52:37.1129896Z         return
2026-10-23T16:52:37.1130257Z     }
2026-10-23T16:52:37.1131600Z     Set-Item -Path 'function:global:Compile-AppWithBcCompilerFolder' -Value ([scriptblock]::Create($patched))
2026-10-23T16:52:37.1132564Z }
2026-10-23T16:52:37.1132749Z 
2026-10-23T16:52:37.1133513Z # Real helper callback installed by PipelineInitialize: capture inputs BEFORE its post-build copy
2026-10-23T16:52:37.1135659Z # puts the newly compiled product into the symbols folder. Forward every original
2026-10-23T16:52:37.1137452Z # parameter to the genuine helper; keep its error/exit behavior and output sink.
2026-10-23T16:52:37.1139184Z & (Join-Path $env:GITHUB_WORKSPACE 'tools/Assert-AppSourceBuild.ps1') -Stage BeforeCompile -CompilationParams $CompilationParams
2026-10-23T16:52:37.1140122Z $compileLog = Join-Path $env:GITHUB_WORKSPACE ".buildartifacts/AppSourceGate/$env:BuildMode/current-compile.txt"
2026-10-23T16:52:37.1141217Z [System.IO.File]::WriteAllText($compileLog, '')
2026-10-23T16:52:37.1142393Z $forwardOutput = $CompilationParams['OutputTo']
2026-10-23T16:52:37.1143338Z if (-not ($forwardOutput -is [scriptblock])) {
2026-10-23T16:52:37.1143896Z     throw 'Actual helper compiler output callback unavailable.'
2026-10-23T16:52:37.1144267Z }
2026-10-23T16:52:37.1144684Z $actual = $CompilationParams.Clone()
2026-10-23T16:52:37.1145017Z $actual.OutputTo = {
2026-10-23T16:52:37.1145381Z     param($Line)
2026-10-23T16:52:37.1145932Z     [System.IO.File]::AppendAllText($compileLog, ([string]$Line + [Environment]::NewLine), [System.Text.UTF8Encoding]::new($false))
2026-10-23T16:52:37.1147080Z     $forwardOutput.Invoke($Line) | Out-Null
2026-10-23T16:52:37.1147405Z }.GetNewClosure()
2026-10-23T16:52:37.1147667Z Enable-LinuxCompilerManifestStamps
2026-10-23T16:52:37.1148397Z Compile-AppWithBcCompilerFolder @actual
