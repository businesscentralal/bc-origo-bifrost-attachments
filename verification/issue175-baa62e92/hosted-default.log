2026-10-23T16:52:37.1054757Z # AL-Go v9.2 does NOT include CompileAppWithBcCompilerFolder in its automatic
2026-10-23T16:52:37.1056584Z # override registry. Install Run-AlPipeline's real callback using the same
2026-10-23T16:52:37.1058524Z # parent-context scope mechanism as the downloaded Alpaca initialization.
2026-10-23T16:52:37.1059387Z # Do not displace an existing owner's compiler override.
2026-10-23T16:52:37.1060402Z function Set-AppSourceCompilerCallback {
2026-10-23T16:52:37.1061655Z     $existing = Get-Variable -Name 'CompileAppWithBcCompilerFolder' -Scope 2 -ValueOnly -ErrorAction Stop
2026-10-23T16:52:37.1063338Z     if ($existing) {
2026-10-23T16:52:37.1064487Z         throw 'Existing compiler-folder override requires owner coordination; refusing to replace it.'
2026-10-23T16:52:37.1066580Z     }
2026-10-23T16:52:37.1067915Z     $callback = (Get-Command (Join-Path $env:GITHUB_WORKSPACE '.AL-Go/CompileAppWithBcCompilerFolder.ps1')).ScriptBlock
2026-10-23T16:52:37.1070168Z     Set-Variable -Name 'CompileAppWithBcCompilerFolder' -Value $callback -Scope 2
2026-10-23T16:52:37.1071493Z }
