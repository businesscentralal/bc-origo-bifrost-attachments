2026-10-23T16:52:37.1289136Z         }
2026-10-23T16:52:37.1289561Z         $rulesetFileForTestApps = $alpacaSettings.rulesetFileForTestApps
2026-10-23T16:52:37.1291631Z         $rulesetFileForTestApps = CheckRelativePath -baseFolder $baseFolder -sharedFolder $sharedFolder -path $rulesetFileForTestApps -name "rulesetFileForTestApps"
2026-10-23T16:52:37.1293504Z 
