2026-10-23T16:52:37.1161861Z     "$($compilationParamsForDebug | ConvertTo-Json -Depth 2)" -split "`n" | ForEach-Object { Write-AlpacaDebug $_ }
2026-10-23T16:52:37.1163576Z     Write-AlpacaGroupEnd #Level 2
